{{- /* layouts/_default/sitemap.xml
     Sitemap custom que emite SOLO paginas indexables.

     La logica de "que es thin content / noindex" vive centralizada en
     layouts/partials/is_noindex.html y se reutiliza aqui para garantizar
     que el sitemap y la meta-robots de baseof.html NUNCA diverjan.

     Antes, este template reimplementaba a mano las exclusiones y se habia
     desincronizado: no excluia las paginas individuales de problema
     (.Layout == "problema") que is_noindex.html marca noindex cuando son
     generadas. Resultado: ~1.100 URLs noindex se enviaban en el sitemap y
     Google las clasificaba como "Descubierta/Rastreada sin indexar".

     Prioridad y changefreq se asignan por tipo de pagina.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range site.Pages }}

    {{- /* ---- Excluir toda pagina noindex (fuente unica de verdad) ---- */}}
    {{- if partial "is_noindex.html" . }}{{ continue }}{{ end }}

    {{- /* ---- Prioridad por tipo de pagina ---- */}}
    {{- $priority := "0.5" }}
    {{- if .IsHome }}
      {{- $priority = "1.0" }}
    {{- else if eq .Section "marcas" }}
      {{- $priority = "0.85" }}
    {{- else if eq .Section "guias" }}
      {{- $priority = "0.80" }}
    {{- else if and (eq .Type "modelos") .Params.brandKey (not .Params.catKey) }}
      {{- $priority = "0.65" }}
    {{- else if eq .Layout "recambio" }}
      {{- $priority = "0.55" }}
    {{- else if eq .Layout "problema" }}
      {{- $priority = "0.50" }}
    {{- end }}

    {{- /* ---- Changefreq por tipo ---- */}}
    {{- $changefreq := "weekly" }}
    {{- if eq .Section "guias" }}{{ $changefreq = "monthly" }}{{ end }}
    {{- if eq .Layout "problema" }}{{ $changefreq = "monthly" }}{{ end }}

  <url>
    <loc>{{ .Permalink }}</loc>
    {{ with .Lastmod }}<lastmod>{{ .Format "2006-01-02" }}</lastmod>{{ end }}
    <changefreq>{{ $changefreq }}</changefreq>
    <priority>{{ $priority }}</priority>
  </url>
  {{- end }}
</urlset>
